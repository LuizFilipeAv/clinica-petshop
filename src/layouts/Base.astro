---
import '@fontsource-variable/figtree/wght';
import '@fontsource-variable/fredoka/wght';
import '@fontsource/big-shoulders-display/latin-900';
import '../styles/global.css';
interface Props { title?: string; description?: string }
const {
  title = 'Bigode — Clínica veterinária & petshop',
  description = 'Consultas, vacinas, banho & tosa e hotel para cães e gatos. Cuidado de verdade, do primeiro miado ao último latido.',
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E359D" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed; top: 0.75rem; left: 0.75rem; z-index: 200;
    padding: 0.6em 1em; border-radius: 999px;
    background: var(--blue); color: var(--white); font-weight: 700; text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--dur) var(--ease-out);
  }
  .skip:focus-visible { transform: none; }
</style>
