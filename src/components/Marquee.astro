---
/**
 * Decorative ticker band. The moving track is aria-hidden; a visually-hidden
 * list carries the same services for screen readers.
 * tone: 'blue' (default) or 'coral'. reverse: scrolls in the opposite direction.
 */
interface Props {
  reverse?: boolean;
  tone?: 'blue' | 'coral';
}
const { reverse = false, tone = 'blue' } = Astro.props;

const items = ['Consultas', 'Vacinas', 'Banho & tosa', 'Hotel', 'Petshop', 'Emergência 24h'];
---

<div class:list={['marquee', `marquee--${tone}`]}>
  <div class="marquee__band">
    <div class:list={['marquee__track', { 'marquee__track--reverse': reverse }]} aria-hidden="true">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {items.map((label) => (
            <span class="marquee__item">
              {label}
              <svg class="paw" viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <ellipse cx="12" cy="16" rx="5.6" ry="4.6" />
                <ellipse cx="4.6" cy="10.2" rx="2.1" ry="2.7" />
                <ellipse cx="9.2" cy="5.6" rx="2.1" ry="2.7" />
                <ellipse cx="14.8" cy="5.6" rx="2.1" ry="2.7" />
                <ellipse cx="19.4" cy="10.2" rx="2.1" ry="2.7" />
              </svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <ul class="visually-hidden">
    {items.map((label) => <li>{label}</li>)}
  </ul>
</div>

<style>
  /* Outer wrapper clips the rotated, 110vw band so the page never scrolls sideways.
     Vertical padding leaves room for the rotated corners. */
  .marquee {
    position: relative;
    overflow: clip;
    padding-block: 2.5rem;
  }

  .marquee__band {
    width: 110vw;
    margin-left: -5vw;
    transform: rotate(-2deg);
    background: var(--blue);
    color: var(--white);
    padding-block: 0.22em;
    overflow: clip;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 28s linear infinite;
    will-change: transform;
  }
  .marquee__track--reverse { animation-direction: reverse; }
  .marquee__band:hover .marquee__track { animation-play-state: paused; }

  .marquee__group { display: flex; flex: none; }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-inline: 0.45em;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .paw {
    flex: none;
    width: 0.6em;
    height: 0.6em;
    fill: var(--coral);
  }

  .marquee--coral .marquee__band { background: var(--coral); color: var(--blue); }
  .marquee--coral .paw { fill: var(--blue); }

  @keyframes marquee-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }
</style>
