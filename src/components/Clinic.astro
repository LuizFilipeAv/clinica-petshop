---
import { Picture } from 'astro:assets';
import space from '../assets/img/clinic-space.webp';
---

<section class="clinic" aria-labelledby="espaco-title">
  <div class="container head">
    <h2 id="espaco-title" class="display title" data-split>Um espaço pensado pra eles</h2>
    <p class="lead" data-reveal="up">
      Salas separadas para cães e gatos, piso que não escorrega e uma recepção onde ninguém precisa esperar
      apertado. Consultório, exames e internação ficam no mesmo endereço, pra você não sair correndo com o
      bicho no colo.
    </p>
  </div>

  <div class="stage" data-stage>
    <div class="frame" data-frame>
      <div class="inner" data-inner>
        <Picture
          src={space}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={[640, 1000, 1400, 1672]}
          sizes="(min-width: 900px) calc(100vw - 4rem), 100vw"
          alt="Recepção clara da clínica Bigode, com poltronas azuis e coral e um golden retriever deitado no chão"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <ul class="tags" data-tags data-stagger>
      <li class="tag" data-reveal="up">Sala só para gatos</li>
      <li class="tag" data-reveal="up">Internação monitorada</li>
      <li class="tag" data-reveal="up">Raio-X digital</li>
    </ul>
  </div>
</section>

<style>
  .clinic {
    padding-block: var(--section);
  }

  .head {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.4vw, 1.75rem);
    margin-bottom: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }
  .title {
    font-size: var(--step-4);
    max-width: 14ch;
  }
  .lead {
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .stage {
    position: relative;
    width: calc(100% - 2 * var(--gutter));
    max-width: 1800px;
    margin-inline: auto;
  }

  /* final (expanded) state is the CSS default: no-JS and reduced motion get the full image */
  .frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-l);
    clip-path: inset(0 0 0 0 round var(--radius-l));
    background: var(--paper);
    will-change: clip-path;
  }
  .inner {
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .frame :global(picture),
  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 50%;
  }

  .tags {
    position: absolute;
    left: clamp(0.75rem, 0.4rem + 1.6vw, 2rem);
    bottom: clamp(0.75rem, 0.4rem + 1.6vw, 2rem);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    padding: 0.6em 1.1em;
    border-radius: 999px;
    background: var(--white);
    color: var(--blue);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.2;
    box-shadow: var(--shadow-soft);
  }

  @media (min-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      column-gap: clamp(2rem, 6vw, 6rem);
    }
    .frame { aspect-ratio: 16 / 9; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../scripts/motion';

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const frame = stage?.querySelector<HTMLElement>('[data-frame]');
  const inner = stage?.querySelector<HTMLElement>('[data-inner]');
  const tags = stage?.querySelector<HTMLElement>('[data-tags]');

  if (stage && frame && inner && !reduced) {
    // side/top insets (% of the frame) for the starting "~70% wide" rounded rectangle
    const inset = () => (window.innerWidth >= 900 ? { x: 15, y: 9 } : { x: 8, y: 6 });
    // mirrors --radius-l: clamp(24px, 1rem + 2vw, 44px)
    const radius = () => Math.min(44, Math.max(24, 16 + window.innerWidth * 0.02));

    const trigger = {
      trigger: stage,
      start: 'top 88%',
      end: 'top 22%',
      scrub: true,
      invalidateOnRefresh: true,
    };

    gsap.fromTo(
      frame,
      {
        clipPath: () => {
          const { x, y } = inset();
          return `inset(${y}% ${x}% ${y}% ${x}% round ${radius()}px)`;
        },
      },
      { clipPath: () => `inset(0% 0% 0% 0% round ${radius()}px)`, ease: 'none', scrollTrigger: trigger },
    );

    // depth: the photo settles while the window opens
    gsap.fromTo(inner, { scale: 1.12 }, { scale: 1, ease: 'none', scrollTrigger: trigger });

    // keep the tags inside the visible part of the photo while the frame is still inset
    if (tags) {
      gsap.fromTo(
        tags,
        {
          x: () => (stage.offsetWidth * inset().x) / 100,
          y: () => -(stage.offsetHeight * inset().y) / 100,
        },
        { x: 0, y: 0, ease: 'none', scrollTrigger: trigger },
      );
    }

    ScrollTrigger.refresh();
  }
</script>
