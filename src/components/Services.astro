---
import { Picture } from 'astro:assets';
import consulta from '../assets/img/service-consulta.webp';
import vacina from '../assets/img/service-vacina.webp';
import banho from '../assets/img/service-banho.webp';
import hotel from '../assets/img/service-hotel.webp';

type Service = {
  id: string;
  title: string;
  text: string;
  details: string[];
  img: ImageMetadata;
  alt: string;
  tone: 'blue' | 'coral';
  pos: string;
};

const services: Service[] = [
  {
    id: 'consulta',
    title: 'Consulta veterinária',
    text: 'Escuta atenta, sem pressa e sem susto. Avaliamos seu pet de focinho a rabo e explicamos tudo em português claro.',
    details: ['Clínico geral e especialistas', 'Exames no mesmo dia', 'Retorno incluso em até 15 dias'],
    img: consulta,
    alt: 'Beagle sentado em preto e branco, olhando para cima enquanto uma veterinária de luvas ouve seu coração com um estetoscópio, sobre fundo azul',
    tone: 'blue',
    pos: '45% 18%',
  },
  {
    id: 'vacina',
    title: 'Vacinação',
    text: 'Esquema completo para filhotes e adultos, aplicado numa sala calma e com petisco de recompensa no final.',
    details: ['Carteirinha digital', 'Lembrete de reforço por mensagem', 'Sala tranquila para gatos'],
    img: vacina,
    alt: 'Gatinho em preto e branco com um curativo coral na pata, depois da vacina, sobre fundo coral',
    tone: 'coral',
    pos: '50% 30%',
  },
  {
    id: 'banho',
    title: 'Banho & tosa',
    text: 'Água morna, secagem sem estresse e aquele cheirinho de bicho novo. Tosa na máquina ou na tesoura, você escolhe.',
    details: ['Produtos hipoalergênicos', 'Tosa higiênica e na tesoura', 'Leva e traz de carro'],
    img: banho,
    alt: 'Poodle molhado, em preto e branco, enrolado numa toalha e cercado de bolhas de sabão, sobre fundo azul',
    tone: 'blue',
    pos: '50% 30%',
  },
  {
    id: 'hotel',
    title: 'Hotel & creche',
    text: 'Um dia de brincadeira com a turma ou noites de sono na caminha, com monitores por perto o tempo todo.',
    details: ['Monitores 24 horas', 'Área de brincar e passeios', 'Boletim diário com fotos'],
    img: hotel,
    alt: 'Golden retriever dormindo com o focinho apoiado nas patas, numa caminha felpuda, em preto e branco sobre fundo coral',
    tone: 'coral',
    pos: '50% 100%',
  },
];
---

<section id="servicos" class="services" aria-labelledby="servicos-title">
  <div class="container">
    <header class="services__head">
      <h2 id="servicos-title" class="display services__title" data-split>
        Tudo que seu pet precisa, num lugar só
      </h2>
      <p class="services__intro" data-reveal="up">
        Do primeiro check-up ao fim de semana de hotel, a equipe da Bigode cuida do seu bicho como cuidaria do nosso.
        Cada serviço tem hora marcada, gente paciente e nenhuma pressa.
      </p>
    </header>

    <ul class="accordion" data-accordion data-stagger>
      {services.map((s, i) => (
        <li
          class:list={['panel', `panel--${s.tone}`, { 'is-open': i === 0 }]}
          data-reveal="up"
          data-cursor="Ver"
          style={`--pos: ${s.pos}`}
        >
          <div class="panel__media">
            <Picture
              src={s.img}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[480, 720, 1024]}
              sizes="(min-width: 1000px) 700px, (min-width: 640px) 50vw, 100vw"
              alt={s.alt}
              loading="lazy"
            />
          </div>

          <button
            type="button"
            class="panel__toggle"
            data-cursor="Ver"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`svc-${s.id}-body`}
            aria-labelledby={`svc-${s.id}-title`}
          >
            <span class="panel__label display" aria-hidden="true">{s.title}</span>
            <span class="panel__plus" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </span>
          </button>

          <div class="panel__body" id={`svc-${s.id}-body`}>
            <h3 class="display panel__title" id={`svc-${s.id}-title`}>{s.title}</h3>
            <p class="panel__text">{s.text}</p>
            <ul class="panel__details">
              {s.details.map((d) => (
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.6l3.2 3L13 4.6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>{d}</span>
                </li>
              ))}
            </ul>
            <div class="panel__action">
              <a class="panel__cta" href="#contato">
                <span>Agendar<span class="visually-hidden">: {s.title}</span></span>
                <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M0 5.6h7.6L4.1 9.1 5 10l5-5-5-5-.9.9 3.5 3.5H0z" fill="currentColor"/></svg>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    background: var(--white);
    padding-block: var(--section);
  }

  /* ---------- Heading ---------- */
  .services__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2.25rem, 1.5rem + 3.5vw, 4.5rem);
  }
  .services__title {
    font-size: var(--step-4);
    color: var(--blue);
  }
  .services__intro {
    max-width: 44ch;
    color: var(--ink-soft);
    font-size: var(--step-0);
  }
  @media (min-width: 1000px) {
    .services__head {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 6rem);
    }
  }

  /* ---------- Panels: mobile first (photo on top, text below, all open) ---------- */
  .accordion {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) and (max-width: 999px) {
    .accordion {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    .accordion .panel:nth-child(even) { margin-top: 3rem; }
  }

  .panel {
    --card-rgb: 1 40 143;
    --card: rgb(var(--card-rgb));
    --muted: 0.8;
    --cta-fg: var(--blue);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--card);
    color: var(--white);
  }
  .panel--coral {
    /* deepened coral: keeps white text at 4.5:1 or better */
    --card-rgb: 196 48 61;
    --muted: 0.9;
    --cta-fg: #b4232f;
  }

  /* Own transition list: global [data-reveal] delay must not hit flex-grow */
  .accordion .panel {
    transition:
      opacity var(--dur-slow) var(--ease-out) calc(var(--i, 0) * 80ms),
      transform var(--dur-slow) var(--ease-out) calc(var(--i, 0) * 80ms),
      filter var(--dur-slow) var(--ease-out) calc(var(--i, 0) * 80ms),
      flex-grow 550ms var(--ease-out) 0s;
  }

  .panel__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 60%, transparent 100%);
  }
  .panel__media :global(picture),
  .panel__media :global(img) {
    width: 100%;
    height: 100%;
  }
  .panel__media :global(img) {
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
  }
  .panel__media :global(picture) {
    transform: scale(1);
    transform-origin: 50% 85%;
    transition: transform 600ms var(--ease-out);
  }
  .panel:hover .panel__media :global(picture) { transform: scale(1.03); }

  .panel__toggle { display: none; }

  .panel__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: -3.5rem;
    padding: 0 1.5rem 1.75rem;
  }
  .panel__title {
    font-size: var(--step-3);
    color: var(--white);
  }
  .panel__text {
    color: rgb(255 255 255 / var(--muted));
    font-size: var(--step-0);
    line-height: 1.5;
    max-width: 38ch;
  }
  .panel__details {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    color: rgb(255 255 255 / var(--muted));
    font-size: var(--step--1);
  }
  .panel__details li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .panel__details svg {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    color: var(--white);
  }
  .panel__action { margin-top: 0.35rem; }

  .panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 44px;
    padding: 0.7em 1.25em;
    border-radius: 999px;
    background: var(--white);
    color: var(--cta-fg);
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease-back),
      box-shadow var(--dur) var(--ease-out);
  }
  .panel__cta svg {
    width: 0.8em;
    height: 0.8em;
    transition: transform var(--dur) var(--ease-out);
  }
  .panel__cta:hover {
    transform: translate3d(0, -2px, 0);
    box-shadow: 0 14px 26px -14px rgb(0 0 0 / 0.5);
  }
  .panel__cta:hover svg { transform: translateX(3px); }
  .panel__cta:active { transform: scale(0.96); }
  .panel :focus-visible { outline-color: var(--white); }

  /* ---------- Desktop: horizontal accordion ---------- */
  @media (min-width: 1000px) {
    .accordion {
      display: flex;
      gap: 1rem;
      height: clamp(580px, 82vh, 760px);
    }
    .accordion .panel {
      display: block;
      flex: 1 1 0;
      min-width: 0;
    }
    .accordion .panel.is-open { flex-grow: 3.4; }

    .panel__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
      -webkit-mask-image: none;
      mask-image: none;
      z-index: 0;
    }
    .panel__media :global(picture) { transform: scale(1.04); transform-origin: 50% 60%; }
    .panel.is-open .panel__media :global(picture) { transform: scale(1); }
    .panel:hover .panel__media :global(picture) { transform: scale(1); }

    /* top scrim (collapsed, behind the vertical title) and bottom scrim (open, behind the text) */
    .panel::before,
    .panel::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      transition: opacity 450ms var(--ease-out);
    }
    .panel::before {
      background: linear-gradient(to bottom, rgb(var(--card-rgb) / 0.7) 0%, rgb(var(--card-rgb) / 0) 48%);
      opacity: 1;
    }
    .panel::after {
      background: linear-gradient(
        to top,
        rgb(var(--card-rgb) / 0.97) 0%,
        rgb(var(--card-rgb) / 0.92) 32%,
        rgb(var(--card-rgb) / 0) 74%
      );
      opacity: 0;
    }
    .panel.is-open::before { opacity: 0; }
    .panel.is-open::after { opacity: 1; }

    /* full-panel button: tap/click target and collapsed vertical title */
    .panel__toggle {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 0 1.25rem;
      width: 100%;
      border-radius: inherit;
      color: var(--white);
      text-align: center;
    }
    .panel__toggle:focus-visible { outline-offset: -6px; }
    .panel__label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: var(--step-2);
      white-space: nowrap;
      transition: opacity 250ms linear 150ms;
    }
    .panel.is-open .panel__label {
      opacity: 0;
      transition-delay: 0s;
      transition-duration: 120ms;
    }
    .panel__plus {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgb(255 255 255 / 0.22);
      transition: transform var(--dur) var(--ease-back), opacity var(--dur-fast) linear;
    }
    .panel__plus svg { width: 16px; height: 16px; }
    .panel__toggle:hover .panel__plus { transform: rotate(90deg); }
    .panel__toggle:active .panel__plus { transform: rotate(90deg) scale(0.9); }
    .panel.is-open .panel__plus { opacity: 0; transform: scale(0.6); }

    /* body: fixed width so text never reflows while the panel grows */
    .panel__body {
      position: absolute;
      left: 0;
      bottom: 0;
      z-index: 3;
      width: 27rem;
      margin: 0;
      padding: 0 1.75rem 1.75rem;
      visibility: hidden;
      transition: visibility 0s linear 160ms;
    }
    .panel.is-open .panel__body {
      visibility: visible;
      transition-delay: 0s;
    }
    .panel__body > * {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
      transition:
        opacity 160ms linear,
        transform 160ms var(--ease-out);
    }
    .panel.is-open .panel__body > * {
      opacity: 1;
      transform: none;
      transition:
        opacity 420ms var(--ease-out) calc(200ms + var(--k, 0) * 55ms),
        transform 520ms var(--ease-out) calc(200ms + var(--k, 0) * 55ms);
    }
    .panel__body > :nth-child(2) { --k: 1; }
    .panel__body > :nth-child(3) { --k: 2; }
    .panel__body > :nth-child(4) { --k: 3; }
  }
</style>

<script>
  const desktop = window.matchMedia('(min-width: 1000px)');

  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>(':scope > .panel'));
    const toggles = panels.map((p) => p.querySelector<HTMLButtonElement>('.panel__toggle')!);
    let timer = 0;
    let wasOpen = false;
    let pointerType = '';

    const setOpen = (target: HTMLElement | null) => {
      panels.forEach((p, i) => {
        const on = p === target;
        p.classList.toggle('is-open', on);
        toggles[i].setAttribute('aria-expanded', String(on));
      });
    };

    panels.forEach((panel, i) => {
      const toggle = toggles[i];

      // Mouse hover: small intent delay so the resizing panels do not make the pointer flip-flop.
      panel.addEventListener('pointerenter', (e) => {
        if (!desktop.matches || e.pointerType !== 'mouse') return;
        window.clearTimeout(timer);
        if (panel.classList.contains('is-open')) return;
        timer = window.setTimeout(() => setOpen(panel), 90);
      });
      panel.addEventListener('pointerleave', () => window.clearTimeout(timer));

      // Keyboard: focus expands the panel (links inside become reachable).
      panel.addEventListener('focusin', () => {
        if (desktop.matches) setOpen(panel);
      });

      // Touch / pen / click: the button toggles.
      toggle.addEventListener('pointerdown', (e) => {
        pointerType = e.pointerType;
        wasOpen = panel.classList.contains('is-open');
      });
      toggle.addEventListener('click', (e) => {
        window.clearTimeout(timer);
        if (e.detail === 0) {
          // keyboard activation (focusin already opened it)
          setOpen(panel.classList.contains('is-open') ? null : panel);
        } else if (pointerType !== 'mouse' && wasOpen) {
          setOpen(null);
        } else {
          setOpen(panel);
        }
        pointerType = '';
      });
    });
  });
</script>
