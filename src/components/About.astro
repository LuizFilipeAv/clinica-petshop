---
import { Picture } from 'astro:assets';
import vet from '../assets/img/about-vet.webp';
---

<section id="clinica" class="about" aria-labelledby="sobre-title">
  <div class="card">
    <div class="copy" data-stagger>
      <h2 id="sobre-title" class="display title" data-split>
        Gente que ama <span class="hl">bicho</span> tanto quanto você
      </h2>

      <p class="lead" data-reveal="up">
        A Dra. Marina Albuquerque (CRMV-SP 48.213) abriu a Bigode há 12 anos com uma ideia simples: tratar cada
        pet pelo nome e cada tutor como parte da equipe. Hoje somos veterinários, auxiliares e banhistas que
        conhecem o ronco do seu cachorro e o jeito do seu gato de pedir colo.
      </p>

      <dl class="facts" data-reveal="up">
        <div class="fact">
          <dt>anos de clínica</dt>
          <dd><span class="num" data-count="12">12</span></dd>
        </div>
        <div class="fact">
          <dt>pets atendidos</dt>
          <dd><span class="num" data-count="8000" data-suffix="+">8.000+</span></dd>
        </div>
        <div class="fact">
          <dt>plantão de emergência</dt>
          <dd><span class="num" data-count="24" data-suffix="h">24h</span></dd>
        </div>
      </dl>

      <a class="btn btn--ghost" href="#contato" data-reveal="up" data-magnetic>
        Conheça a equipe
        <span class="btn__arrow" aria-hidden="true">
          <svg viewBox="0 0 10 10"><path d="M0 5.6h7.6L4.1 9.1 5 10l5-5-5-5-.9.9 3.5 3.5H0z" fill="currentColor"></path></svg>
        </span>
      </a>
    </div>

    <div class="photo" data-reveal="up">
      <Picture
        src={vet}
        formats={['avif', 'webp']} fallbackFormat="webp"
        widths={[480, 800, 1024]}
        sizes="(min-width: 900px) 48vw, 90vw"
        alt="Veterinária sorrindo com um buldogue francês nos braços"
        loading="lazy"
        decoding="async"
      />

      <svg class="scribble" viewBox="0 0 170 110" fill="none" aria-hidden="true" data-draw>
        <path
          d="M6 12C52-6 92 22 70 46C54 64 26 44 52 30C84 14 124 52 152 94"
          stroke="var(--coral)"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
        <path
          d="M131 87.6L152 94L147 72.6"
          stroke="var(--coral)"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(1rem, 4vw, 3rem) var(--gutter);
  }

  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(1.25rem, 0.5rem + 4vw, 4.5rem) 0;
    background: var(--photo-blue);
    color: var(--white);
    border-radius: var(--radius-l);
    overflow: clip;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    padding-bottom: clamp(2rem, 1.5rem + 3vw, 3.5rem);
  }

  .title {
    font-size: var(--step-4);
    max-width: 12ch;
  }
  .hl { color: var(--coral-soft); }

  .lead {
    max-width: 52ch;
    color: rgb(255 255 255 / 0.86);
    font-size: var(--step-0);
  }

  /* typographic facts, separated by hairlines */
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    max-width: 38rem;
    padding-top: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }
  .fact {
    display: flex;
    flex-direction: column-reverse; /* dt reads first in the DOM, number shows first */
    justify-content: flex-end;
    gap: 0.4rem;
    padding-inline: clamp(0.6rem, 0.2rem + 2vw, 1.75rem);
    border-inline-start: 1px solid rgb(255 255 255 / 0.2);
  }
  .fact:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .fact dd { margin: 0; }
  .num {
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 1.1rem + 3.6vw, 3.75rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .fact dt {
    font-size: var(--step--1);
    line-height: 1.25;
    color: rgb(255 255 255 / 0.78);
  }

  /* photo sits IN the section: same blue backdrop, flush to the card's bottom edge */
  .photo {
    position: relative;
    align-self: end;
    justify-self: center;
    width: min(100%, 460px);
    line-height: 0;
  }
  .photo :global(picture),
  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: 0;
  }

  .scribble {
    display: none;
    position: absolute;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      column-gap: clamp(1rem, 3vw, 3rem);
      padding-bottom: 0;
    }
    .copy {
      align-self: center;
      padding-block: 0 clamp(2.5rem, 4vw, 4.5rem);
    }
    .photo {
      justify-self: end;
      width: min(100%, 640px);
      margin-bottom: -3%; /* bleeds slightly off the bottom edge */
    }
    .scribble {
      display: block;
      top: 6%;
      left: 2%;
      width: 24%;
      height: auto;
      z-index: 1;
    }
  }

  @media (min-width: 1280px) {
    .photo { width: min(100%, 700px); }
  }
</style>
