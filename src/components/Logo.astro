---
/**
 * Wordmark "bigode": the "o" is a cat face — ears, eyes and coral whiskers.
 * Scales with font-size; pass `class` to size it.
 */
interface Props { class?: string; id?: string; tag?: 'span' | 'h1' | 'div' }
const { class: className = '', id, tag: Tag = 'span' } = Astro.props;
---
<Tag class:list={['logo', className]} id={id} aria-label="Bigode — clínica veterinária e petshop">
  <span class="logo__txt" aria-hidden="true">big</span><span class="logo__o" aria-hidden="true">
    <svg viewBox="0 0 120 120" fill="none">
      <!-- ears -->
      <path class="logo__ear logo__ear--l" d="M22 52 L26 8 Q28 2 33 6 L60 30" fill="currentColor" />
      <path class="logo__ear logo__ear--r" d="M98 52 L94 8 Q92 2 87 6 L60 30" fill="currentColor" />
      <!-- head ring -->
      <circle cx="60" cy="68" r="38" stroke="currentColor" stroke-width="17" fill="var(--logo-fill, transparent)" />
      <!-- eyes -->
      <g class="logo__eyes" fill="currentColor">
        <ellipse cx="47" cy="64" rx="5" ry="6.5" />
        <ellipse cx="73" cy="64" rx="5" ry="6.5" />
      </g>
      <path d="M55 76 Q60 81 65 76" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      <!-- whiskers -->
      <g class="logo__whiskers" stroke="var(--coral)" stroke-width="4.5" stroke-linecap="round">
        <g class="logo__wl"><path d="M30 74 H8" /><path d="M31 83 L10 90" /></g>
        <g class="logo__wr"><path d="M90 74 H112" /><path d="M89 83 L110 90" /></g>
      </g>
    </svg>
  </span><span class="logo__txt" aria-hidden="true">de</span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-logo);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--blue);
    white-space: nowrap;
  }
  .logo__o {
    position: relative;
    display: inline-block;
    width: 0.66em;
    height: 0.5em;
    margin-inline: 0.01em 0.02em;
  }
  .logo__o svg {
    position: absolute;
    left: 50%;
    bottom: -0.11em;
    width: 0.86em;
    height: 0.86em;
    translate: -50% 0;
    overflow: visible;
  }
  .logo__ear { transform-box: fill-box; transition: transform 380ms var(--ease-back); }
  .logo__ear--l { transform-origin: 30% 100%; }
  .logo__ear--r { transform-origin: 70% 100%; }
  .logo__wl, .logo__wr { transform-box: fill-box; transition: transform 300ms var(--ease-back); }
  .logo__wl { transform-origin: 100% 50%; }
  .logo__wr { transform-origin: 0% 50%; }
  .logo__eyes { transform-box: fill-box; transform-origin: 50% 50%; animation: blink 5.5s infinite; }

  :global(a:hover) > .logo .logo__ear--l, .logo:hover .logo__ear--l { transform: rotate(-12deg); }
  :global(a:hover) > .logo .logo__ear--r, .logo:hover .logo__ear--r { transform: rotate(12deg); }
  :global(a:hover) > .logo .logo__wl, .logo:hover .logo__wl { transform: rotate(8deg) scaleX(1.1); }
  :global(a:hover) > .logo .logo__wr, .logo:hover .logo__wr { transform: rotate(-8deg) scaleX(1.1); }

  @keyframes blink {
    0%, 94%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
</style>
