---
import Logo from './Logo.astro';

const sections = [
  { href: '#servicos', label: 'Serviços' },
  { href: '#clinica', label: 'Clínica' },
  { href: '#petshop', label: 'Petshop' },
  { href: '#depoimentos', label: 'Depoimentos' },
  { href: '#contato', label: 'Contato' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo class="footer-logo" />
        <p class="footer__tagline">Cuidado de verdade, do primeiro miado ao último latido.</p>
      </div>

      <nav class="footer__col" aria-labelledby="footer-nav-title">
        <h2 class="footer__title" id="footer-nav-title">Navegação</h2>
        <ul class="footer__list">
          {sections.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </nav>

      <address class="footer__col">
        <h2 class="footer__title" id="footer-contact-title">Contato</h2>
        <ul class="footer__list">
          <li>Rua dos Pinheiros, 1200 — São Paulo</li>
          <li><a href="tel:+551130000000">(11) 3000-0000</a></li>
          <li><a href="mailto:oi@bigode.vet">oi@bigode.vet</a></li>
        </ul>
      </address>

      <div class="footer__col">
        <h2 class="footer__title" id="footer-social-title">Redes</h2>
        <ul class="footer__list">
          <li>
            <a href="#" class="footer__social">
              <svg class="footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <path d="M17.5 6.5h.01" />
              </svg>
              Instagram
            </a>
          </li>
          <li>
            <a href="#" class="footer__social">
              <svg class="footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" />
                <path d="M14 3c.4 2.6 2.2 4.4 5 4.7" />
              </svg>
              TikTok
            </a>
          </li>
          <li>
            <a href="#" class="footer__social">
              <svg class="footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2" y="5" width="20" height="14" rx="4" />
                <path d="M10 9.5v5l4.5-2.5z" />
              </svg>
              YouTube
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© 2026 Bigode — projeto conceitual de portfólio.</p>
      <a href="#top" class="footer__top-link">
        Voltar ao topo
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M12 19V5M5 12l7-7 7 7" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--white);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
  }

  /* Logo: the shared Logo component sets its own blue, so target it with higher specificity. */
  .footer :global(.footer-logo) {
    color: var(--white);
    font-size: clamp(3rem, 10vw, 8rem);
  }

  .footer__grid {
    display: grid;
    gap: 2.75rem;
  }
  .footer__brand {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }
  .footer__tagline {
    max-width: 30ch;
    font-size: var(--step-1);
    line-height: 1.3;
    font-weight: 600;
    text-wrap: balance;
  }

  .footer__col { font-style: normal; color: rgb(255 255 255 / 0.7); }
  .footer__title {
    margin-bottom: 0.9rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--white);
  }
  .footer__list {
    display: grid;
    padding: 0;
    list-style: none;
  }
  .footer__list a,
  .footer__list li {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__social { gap: 0.6rem; }
  .footer__icon { width: 20px; height: 20px; flex: none; }

  /* Links: underline fades in on hover, colour shifts to coral */
  .footer a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-fast) linear,
      text-decoration-color var(--dur) var(--ease-out);
  }
  .footer a:hover {
    color: var(--coral);
    text-decoration-color: currentColor;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: var(--step--1);
    color: rgb(255 255 255 / 0.7);
  }
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 44px;
    color: var(--white);
  }
  .footer__top-link svg {
    width: 20px;
    height: 20px;
    transition: transform var(--dur) var(--ease-back);
  }
  .footer__top-link:hover svg { transform: translateY(-3px); }

  /* Responsive: stacked on mobile, 3 columns under the brand on tablet, 4-col grid on desktop */
  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
    .footer__brand { grid-column: auto; }
  }
</style>
