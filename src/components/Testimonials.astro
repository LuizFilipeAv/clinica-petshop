---
import { Picture } from 'astro:assets';
import a1 from '../assets/img/pet-avatar-1.webp';
import a2 from '../assets/img/pet-avatar-2.webp';
import a3 from '../assets/img/pet-avatar-3.webp';

const items = [
  {
    pet: 'Paçoca', tutor: 'Marina Teixeira', bairro: 'Vila Madalena', img: a1,
    quote: 'A Paçoca tinha pavor de veterinário. Aqui ela entrou abanando o rabo, saiu com biscoito, e eu saí com o exame explicado em português de gente.',
  },
  {
    pet: 'Chumbinho', tutor: 'Rodrigo Álvares', bairro: 'Pompeia', img: a2,
    quote: 'O Chumbinho odeia tudo e todos. A doutora sentou no chão, esperou ele chegar sozinho e só depois pegou o estetoscópio. Já marquei o retorno.',
  },
  {
    pet: 'Salsicha', tutor: 'Camila Nogueira', bairro: 'Perdizes', img: a3,
    quote: 'Levei a Salsicha para um banho e voltei com ela cheirosa e uma foto no WhatsApp. É atendimento de quem gosta de bicho de verdade.',
  },
];
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z';
---
<section id="depoimentos" class="testi" aria-labelledby="dep-title">
  <div class="container testi__grid">
    <h2 id="dep-title" class="display testi__title" data-split>Quem confia, abana o rabo</h2>

    <div class="testi__stage" data-stage data-reveal="up">
      <svg class="testi__mark" viewBox="0 0 40 30" aria-hidden="true">
        <path d="M0 30V17C0 7 5 1.5 14 0l1.6 4.4C11 6 9 8.6 9 12h6.5v18zM21 30V17C21 7 26 1.5 35 0l1.6 4.4C32 6 30 8.6 30 12h6.5v18z" fill="currentColor" />
      </svg>

      <div class="testi__panels">
        {items.map((it, i) => (
          <article
            class:list={['testi__panel', { 'is-active': i === 0 }]}
            role="tabpanel"
            id={`dep-panel-${i}`}
            aria-labelledby={`dep-tab-${i}`}
          >
            <svg class="testi__stars" viewBox="0 0 120 24" role="img" aria-label="Nota 5 de 5">
              {[0, 1, 2, 3, 4].map((s) => (
                <path d={star} transform={`translate(${s * 24} 0)`} fill="currentColor" />
              ))}
            </svg>
            <blockquote class="testi__quote">{it.quote}</blockquote>
            <p class="testi__who"><strong>{it.pet}</strong> e {it.tutor}, {it.bairro}</p>
          </article>
        ))}
      </div>

      <div class="testi__tabs" role="tablist" aria-label="Escolha um depoimento">
        {items.map((it, i) => (
          <button
            type="button"
            role="tab"
            class="testi__tab"
            id={`dep-tab-${i}`}
            aria-controls={`dep-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="testi__avatar">
              <Picture
                src={it.img}
                formats={['avif', 'webp']} fallbackFormat="webp"
                widths={[88, 176]}
                sizes="88px"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="testi__name">{it.pet}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .testi { background: var(--coral); color: var(--ink); padding-block: var(--section); overflow-x: clip; }

  .testi__grid { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  @media (min-width: 960px) {
    .testi__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: clamp(3rem, 6vw, 6rem); }
  }

  /* blue-deep on coral = 4.7:1; white is decorative only (mark, avatar ring) */
  .testi__title { font-size: var(--step-4); color: var(--blue-deep); max-width: 10ch; }

  .testi__stage { position: relative; padding-top: clamp(2.75rem, 5vw, 4rem); }
  .testi__mark {
    position: absolute; top: 0; left: 0; width: clamp(40px, 5vw, 60px); height: auto;
    color: var(--white);
  }

  .testi__panels { display: grid; }
  .testi__panel {
    grid-area: 1 / 1;
    opacity: 0; visibility: hidden; transform: translate3d(0, 12px, 0);
    transition: opacity 350ms var(--ease-out), transform 350ms var(--ease-out), visibility 0s linear 350ms;
  }
  .testi__panel.is-active {
    opacity: 1; visibility: visible; transform: none;
    transition-delay: 0s, 0s, 0s;
  }

  .testi__stars { width: 120px; height: 24px; color: var(--blue-deep); }
  .testi__quote {
    margin-top: 1.25rem; max-width: 26em;
    font-size: var(--step-2); font-weight: 700; line-height: 1.22; letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .testi__who { margin-top: 1.5rem; font-size: var(--step-0); }
  .testi__who strong { font-weight: 800; }

  .testi__tabs { display: flex; gap: clamp(0.75rem, 2.5vw, 1.5rem); margin-top: clamp(2rem, 4vw, 3rem); }
  .testi__tab {
    display: grid; justify-items: center; gap: 0.5rem; min-width: 64px; padding: 0.35rem 0.25rem;
    border-radius: var(--radius-s);
  }
  .testi__avatar {
    display: block; width: 64px; height: 64px; border-radius: 50%; overflow: clip;
    background: #bbbbbb;
    box-shadow: 0 0 0 0 var(--white);
    transform: scale(0.86);
    transition: transform var(--dur) var(--ease-back), box-shadow var(--dur) var(--ease-out), opacity var(--dur-fast) linear;
    opacity: 0.8;
  }
  .testi__avatar :global(picture) { display: block; width: 100%; height: 100%; }
  .testi__avatar :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .testi__tab:hover .testi__avatar { opacity: 1; transform: scale(0.95); }
  .testi__tab[aria-selected='true'] .testi__avatar {
    opacity: 1; transform: scale(1.22);
    box-shadow: 0 0 0 4px var(--white);
  }
  .testi__tab:active .testi__avatar { transform: scale(0.9); }
  .testi__tab[aria-selected='true']:active .testi__avatar { transform: scale(1.12); }

  .testi__name { font-size: var(--step--1); font-weight: 700; margin-top: 0.3rem; }
  .testi__tab[aria-selected='true'] .testi__name { font-weight: 800; }

  @media (prefers-reduced-motion: reduce) {
    .testi__panel { transform: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('#depoimentos');
  if (root) init(root);

  function init(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const n = tabs.length;

    let index = 0, timer = 0;
    let hovered = false, focused = false, visible = false;

    const schedule = () => {
      clearTimeout(timer);
      if (rm.matches || hovered || focused || !visible || document.hidden) return;
      timer = window.setTimeout(() => select(index + 1), 7000);
    };

    const select = (i: number, focus = false) => {
      index = (i + n) % n;
      tabs.forEach((t, k) => {
        const on = k === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[k].classList.toggle('is-active', on);
      });
      if (focus) tabs[index].focus();
      schedule();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowDown') select(index + 1, true);
        else if (k === 'ArrowLeft' || k === 'ArrowUp') select(index - 1, true);
        else if (k === 'Home') select(0, true);
        else if (k === 'End') select(n - 1, true);
        else return;
        e.preventDefault();
      });
    });

    stage.addEventListener('pointerenter', () => { hovered = true; schedule(); });
    stage.addEventListener('pointerleave', () => { hovered = false; schedule(); });
    stage.addEventListener('focusin', (e) => {
      focused = (e.target as Element).matches(':focus-visible');
      schedule();
    });
    stage.addEventListener('focusout', () => { focused = false; schedule(); });
    document.addEventListener('visibilitychange', schedule);
    rm.addEventListener('change', schedule);

    new IntersectionObserver(
      (entries) => {
        visible = entries[entries.length - 1].isIntersecting;
        schedule();
      },
      { threshold: 0.3 },
    ).observe(root);
  }
</script>
